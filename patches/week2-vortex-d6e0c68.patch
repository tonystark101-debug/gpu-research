index 636c4b0..0d48bb5 100644
--- a/ci/testcases/dxa.yaml
+++ b/ci/testcases/dxa.yaml
@@ -531,6 +531,45 @@ tests:
   app: dxa_kmajor_check
   configs: -DVX_CFG_EXT_DXA_ENABLE
 
+# Coalesced tiled scatter (VX_CFG_DXA_SCATTER_COALESCE): the BlockMajor, Flat
