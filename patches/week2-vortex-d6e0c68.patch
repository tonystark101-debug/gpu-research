From e0f50599359995f82b105a7182c86e734ea401f5 Mon Sep 17 00:00:00 2001
From: tonystark101-debug
 <61789569+tonystark101-debug@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:14:59 +0530
Subject: [PATCH 1/2] simx/dxa: write every scatter element that shares an LMEM
 block in one beat

The SMEM writer drains a K-major / Flat / BlockMajor scatter one element
per beat, so a 64-byte line of fp16 B becomes 32 LMEM writes even though a
beat can write a whole LMEM row (one 64-byte block per DMA channel) with
byte enables. On sgemm_tcu_wg_dxa (DXA double buffer, fp16 WGMMA, NT=32,
NRC=16, 128x128x256) the writer is the bottleneck: 73,728 LMEM writes, all
8 read slots full for 59,229 of 108,524 cycles, tensor unit busy 3.8%.

Under VX_CFG_DXA_SCATTER_COALESCE a beat gathers every element of the
line that lands in the same 64-byte block into one byte-masked write, then
continues with the line's next block run on the other free channel of the
same row. Off by default: this is SimX-only for now, so it must not move
cycles against the RTL until VX_dxa_smem_wr.sv gets the same change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sim/simx/dxa/dxa_core.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/sim/simx/dxa/dxa_core.cpp b/sim/simx/dxa/dxa_core.cpp
index 1e7f62e..3e1efdd 100644
--- a/sim/simx/dxa/dxa_core.cpp
+++ b/sim/simx/dxa/dxa_core.cpp
@@ -722,6 +722,10 @@ private:
 
     constexpr uint64_t kRowMask = ~uint64_t(DxaCore::LMEM_ROW_SIZE - 1);
     uint64_t beat_row = UINT64_MAX;
+  #ifdef VX_CFG_DXA_SCATTER_COALESCE
+    // Each LMEM DMA channel takes one block write per beat.
+    uint32_t used_halves = 0;
+  #endif
 
     for (uint32_t emitted = 0; emitted < DxaCore::LMEM_PORTS_PER_CORE; ++emitted) {
       slot = w.drain_slot;
@@ -788,6 +792,12 @@ private:
       if (lmem_ch.full()) {
         break; // backpressure
       }
+    #ifdef VX_CFG_DXA_SCATTER_COALESCE
+      if ((used_halves >> half) & 1u) {
+        break; // this row half's channel already carries a write this beat
+      }
+      used_halves |= (1u << half);
+    #endif
 
       // Build LMEM MemReq with TLM payload.
       MemReq req;
@@ -802,7 +812,14 @@ private:
 
       // A contiguous span is one write; a scatter span writes element e0.
       const bool     beat_scatter = lw.scatter;
+    #ifdef VX_CFG_DXA_SCATTER_COALESCE
+      // Coalesced scatter: one write carries every consecutive element of
+      // the line that lands in this block, under a byte mask (the loop below
+      // stops at the first element outside the block or the beat's row).
+      const uint32_t e_end = num_elems;
+    #else
       const uint32_t e_end = beat_scatter ? (e0 + 1) : num_elems;
+    #endif
       uint32_t ee = e0;
       for (; ee < e_end; ++ee) {
         uint64_t dest_byte = dest_byte_of(ee);
@@ -865,9 +882,15 @@ private:
           w.drain_slot = UINT32_MAX;
         }
       }
+    #ifndef VX_CFG_DXA_SCATTER_COALESCE
       if (beat_scatter) {
         break; // a scatter beat writes one element
       }
+    #else
+      // A coalesced scatter beat goes on to the line's next block run if it
+      // lies in the same LMEM row and on a free channel (checked above).
+      (void)beat_scatter;
+    #endif
     } // per-tick row-beat emission loop
   }
 
