+  shape:
+    threads: 32
+    warps: 8
+- id: sgemm_tcu_wg_dxa_mcast-coalesce
+  via: blackbox
+  drivers:
+  - simx
+  - rtlsim
+  app: sgemm_tcu_wg_dxa_mcast
+  configs: -DVX_CFG_EXT_TCU_ENABLE -DVX_CFG_EXT_DXA_ENABLE -DVX_CFG_TCU_TYPE=DPI -DVX_CFG_DXA_SCATTER_COALESCE
+  args: -m 128 -n 64 -k 32
+- id: model_parity-sgemm-tcu-wg-dxa-coalesce
